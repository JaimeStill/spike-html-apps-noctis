// The build, src/ into dist/: tsc emits each module's .js and .d.ts. mise run types checks the same
// sources with --noEmit. The foundation is read as a consumer reads it, through the install of
// the peer at the top level, here its devDependency: its shipped .d.ts.
// Adapted from spike-html-apps-components (9a4392e): tsconfig.json, with no ambient types, since
// no source imports a sheet.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": false
  },
  "include": ["src"]
}
